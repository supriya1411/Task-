<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container my-5 flex-grow-1 d-flex align-items-center justify-content-center">
  <div class="row justify-content-center w-100">
    <div class="col-12 col-md-8 col-lg-6 text-center">
      <div class="card border-0 shadow-sm rounded-4 bg-white p-5">
        <div class="display-1 fw-black text-danger mb-2">
          <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
        </div>
        <h3 class="fw-bold text-dark mb-2">
          <%= statusCode === 404 ? 'Page Not Found' : 'Internal Server Issue' %>
        </h3>
        <p class="text-secondary mb-4">
          <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
        </p>

        <% if (typeof errorDetails !== 'undefined' && errorDetails) { %>
          <div class="text-start bg-light p-3 rounded-3 font-monospace fs-8 text-danger mb-4 overflow-x-auto" style="max-height: 180px;">
            <pre class="m-0"><%= errorDetails %></pre>
          </div>
        <% } %>

        <div class="d-flex justify-content-center gap-2">
          <a href="/" class="btn btn-outline-secondary px-4">Home</a>
          <% if (locals.currentUser) { %>
            <a href="/dashboard" class="btn btn-primary px-4 shadow-sm">Dashboard</a>
          <% } else { %>
            <a href="/login" class="btn btn-primary px-4 shadow-sm">Sign In</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar Partial -->
    <%- include('../partials/sidebar') %>

    <!-- Main Content Area -->
    <main class="col-12 col-md-9 col-lg-10 px-md-4 py-4">
      <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 fs-8">
              <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item"><a href="/tasks">Tasks</a></li>
              <li class="breadcrumb-item active" aria-current="page"><%= isEdit ? 'Edit Task' : 'New Task' %></li>
            </ol>
          </nav>
          <h1 class="h3 fw-bold text-dark mb-0"><%= isEdit ? 'Edit Task' : 'Create New Task' %></h1>
          <p class="text-secondary small mb-0 mt-1">
            <%= isEdit ? 'Update details and synchronize with database & Redis cache.' : 'Add a new task item with category, priority, and deadline.' %>
          </p>
        </div>

        <a href="/tasks" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i> Back to Tasks
        </a>
      </div>

      <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
          <div class="card border-0 shadow-xs rounded-4 bg-white p-4">
            <%- include('../partials/alerts') %>

            <!-- Task Form (Task 1 & Task 2) -->
            <form action="<%= isEdit ? ('/tasks/' + task._id) : '/tasks' %>" method="POST" id="taskForm" novalidate>
              <!-- Task Title -->
              <div class="mb-3">
                <label for="taskTitle" class="form-label small fw-semibold text-dark">
                  Task Title <span class="text-danger">*</span>
                </label>
                <input
                  type="text"
                  class="form-control"
                  id="taskTitle"
                  name="title"
                  placeholder="e.g., Implement Redis Cache Invalidation"
                  value="<%= task.title || '' %>"
                  required
                  minlength="3"
                  maxlength="120"
                />
                <div class="form-text text-muted small">Must be between 3 and 120 characters.</div>
                <div class="invalid-feedback" id="taskTitleFeedback">Please enter a descriptive title (at least 3 characters).</div>
              </div>

              <!-- Description -->
              <div class="mb-3">
                <label for="taskDesc" class="form-label small fw-semibold text-dark">Description</label>
                <textarea
                  class="form-control"
                  id="taskDesc"
                  name="description"
                  rows="4"
                  maxlength="1000"
                  placeholder="Detailed notes, objectives, or acceptance criteria..."
                ><%= task.description || '' %></textarea>
                <div class="d-flex justify-content-between text-muted fs-8 mt-1">
                  <span>Optional context or markdown instructions</span>
                  <span id="charCount">0 / 1000</span>
                </div>
              </div>

              <!-- Category & Priority Row -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label for="taskCategory" class="form-label small fw-semibold text-dark">Category</label>
                  <select class="form-select" id="taskCategory" name="category">
                    <option value="Work" <%= task.category === 'Work' ? 'selected' : '' %>>Work</option>
                    <option value="Personal" <%= task.category === 'Personal' ? 'selected' : '' %>>Personal</option>
                    <option value="Study" <%= task.category === 'Study' ? 'selected' : '' %>>Study</option>
                    <option value="Health" <%= task.category === 'Health' ? 'selected' : '' %>>Health</option>
                    <option value="Finance" <%= task.category === 'Finance' ? 'selected' : '' %>>Finance</option>
                    <option value="Other" <%= task.category === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <div class="col-12 col-md-6">
                  <label for="taskPriority" class="form-label small fw-semibold text-dark">Priority</label>
                  <select class="form-select" id="taskPriority" name="priority">
                    <option value="Low" <%= task.priority === 'Low' ? 'selected' : '' %>>Low (Routine)</option>
                    <option value="Medium" <%= task.priority === 'Medium' || !task.priority ? 'selected' : '' %>>Medium (Standard)</option>
                    <option value="High" <%= task.priority === 'High' ? 'selected' : '' %>>High (Important)</option>
                    <option value="Urgent" <%= task.priority === 'Urgent' ? 'selected' : '' %>>Urgent (Immediate)</option>
                  </select>
                </div>
              </div>

              <!-- Status & Deadline Row -->
              <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                  <label for="taskStatus" class="form-label small fw-semibold text-dark">Status</label>
                  <select class="form-select" id="taskStatus" name="status">
                    <option value="Pending" <%= task.status === 'Pending' || !task.status ? 'selected' : '' %>>Pending</option>
                    <option value="In Progress" <%= task.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                  </select>
                </div>

                <div class="col-12 col-md-6">
                  <label for="taskDeadline" class="form-label small fw-semibold text-dark">Target Deadline</label>
                  <input
                    type="datetime-local"
                    class="form-control"
                    id="taskDeadline"
                    name="deadline"
                    value="<%= task.deadline || '' %>"
                  />
                  <div class="form-text text-muted small">Optional target completion date & time.</div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                <a href="/tasks" class="btn btn-light">Cancel</a>
                <div class="d-flex align-items-center gap-2">
                  <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm d-flex align-items-center gap-2">
                    <i class="bi <%= isEdit ? 'bi-check2' : 'bi-plus-circle' %>"></i>
                    <span><%= isEdit ? 'Update Task' : 'Save Task' %></span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  // Character counter for description
  const descArea = document.getElementById('taskDesc');
  const charSpan = document.getElementById('charCount');
  if (descArea && charSpan) {
    const updateCount = () => {
      charSpan.textContent = `${descArea.value.length} / 1000`;
    };
    descArea.addEventListener('input', updateCount);
    updateCount();
  }
</script>

<%- include('../partials/footer') %>

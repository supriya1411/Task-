<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar Partial -->
    <%- include('../partials/sidebar') %>

    <!-- Main Content Area -->
    <main class="col-12 col-md-9 col-lg-10 px-md-4 py-4">
      <!-- Header with Action Buttons -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-4 border-bottom">
        <div>
          <div class="d-flex align-items-center gap-2">
            <h1 class="h3 fw-bold text-dark mb-0">Task Management</h1>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" id="taskTotalBadge"><%= total %> Tasks</span>
            <% if (fromCache) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle" title="Served directly from Redis Cache (Task 8)">
                <i class="bi bi-lightning-fill"></i> Redis Cache HIT
              </span>
            <% } else { %>
              <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="Retrieved from Database and cached">
                <i class="bi bi-database"></i> DB Query (Cache Stored)
              </span>
            <% } %>
          </div>
          <p class="text-secondary small mb-0 mt-1">
            Browse, filter, search, sort, and manage your tasks with REST API integration.
          </p>
        </div>

        <div class="d-flex align-items-center gap-2">
          <!-- View Toggle (Grid / Table) -->
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary active" id="viewCardsBtn" title="Cards Grid View">
              <i class="bi bi-grid-fill"></i> Cards
            </button>
            <button type="button" class="btn btn-outline-secondary" id="viewTableBtn" title="List Table View">
              <i class="bi bi-table"></i> Table
            </button>
          </div>

          <a href="/tasks/new" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm px-3">
            <i class="bi bi-plus-lg"></i>
            <span>New Task</span>
          </a>
        </div>
      </div>

      <!-- Filter, Search, and Sort Control Toolbar (Task 4) -->
      <div class="card border-0 shadow-xs rounded-4 bg-white p-3 mb-4">
        <div class="row g-2 align-items-center">
          <!-- Live Search Bar -->
          <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-search"></i></span>
              <input
                type="text"
                class="form-control border-start-0"
                id="taskSearchInput"
                placeholder="Search tasks by title or details..."
                value="<%= filters.search %>"
              />
              <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn" title="Clear Search">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
          </div>

          <!-- Status Filter -->
          <div class="col-6 col-md-2">
            <select class="form-select form-select-sm" id="filterStatus">
              <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
              <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
              <option value="In Progress" <%= filters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
              <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            </select>
          </div>

          <!-- Priority Filter -->
          <div class="col-6 col-md-2">
            <select class="form-select form-select-sm" id="filterPriority">
              <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>All Priorities</option>
              <option value="Urgent" <%= filters.priority === 'Urgent' ? 'selected' : '' %>>Urgent</option>
              <option value="High" <%= filters.priority === 'High' ? 'selected' : '' %>>High</option>
              <option value="Medium" <%= filters.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
              <option value="Low" <%= filters.priority === 'Low' ? 'selected' : '' %>>Low</option>
            </select>
          </div>

          <!-- Category Filter -->
          <div class="col-6 col-md-2">
            <select class="form-select form-select-sm" id="filterCategory">
              <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>All Categories</option>
              <option value="Work" <%= filters.category === 'Work' ? 'selected' : '' %>>Work</option>
              <option value="Personal" <%= filters.category === 'Personal' ? 'selected' : '' %>>Personal</option>
              <option value="Study" <%= filters.category === 'Study' ? 'selected' : '' %>>Study</option>
              <option value="Health" <%= filters.category === 'Health' ? 'selected' : '' %>>Health</option>
              <option value="Finance" <%= filters.category === 'Finance' ? 'selected' : '' %>>Finance</option>
              <option value="Other" <%= filters.category === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <!-- Sort Dropdown -->
          <div class="col-6 col-md-2">
            <select class="form-select form-select-sm" id="sortBySelect">
              <option value="createdAt" <%= filters.sortBy === 'createdAt' ? 'selected' : '' %>>Sort: Newest First</option>
              <option value="deadline" <%= filters.sortBy === 'deadline' ? 'selected' : '' %>>Sort: Due Date</option>
              <option value="priority" <%= filters.sortBy === 'priority' ? 'selected' : '' %>>Sort: Priority</option>
              <option value="title" <%= filters.sortBy === 'title' ? 'selected' : '' %>>Sort: Title (A-Z)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Task Containers -->
      <!-- 1. Cards View (Default) -->
      <div id="tasksCardsContainer" class="row g-3">
        <% if (tasks && tasks.length > 0) { %>
          <% tasks.forEach(function(task) { %>
            <div class="col-12 col-md-6 col-lg-4 task-card-item" data-id="<%= task._id %>" data-title="<%= task.title.toLowerCase() %>" data-status="<%= task.status %>" data-priority="<%= task.priority %>" data-category="<%= task.category %>">
              <div class="card h-100 border-0 shadow-xs rounded-4 bg-white p-3 hover-card d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-light text-dark border"><%= task.category %></span>
                  <div class="d-flex align-items-center gap-1">
                    <% if (task.priority === 'Urgent') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Urgent</span>
                    <% } else if (task.priority === 'High') { %>
                      <span class="badge bg-danger text-white">High</span>
                    <% } else if (task.priority === 'Medium') { %>
                      <span class="badge bg-warning-subtle text-dark border border-warning-subtle">Medium</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary">Low</span>
                    <% } %>

                    <div class="dropdown">
                      <button class="btn btn-sm btn-link text-secondary p-0 ms-1" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" href="/tasks/<%= task._id %>/edit"><i class="bi bi-pencil me-2 text-primary"></i>Edit Task</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button class="dropdown-item text-danger delete-task-btn" data-id="<%= task._id %>" data-title="<%= task.title %>">
                            <i class="bi bi-trash3 me-2"></i>Delete Task
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>

                <h5 class="fw-bold text-dark mb-1 task-title-text"><%= task.title %></h5>
                <p class="text-secondary small flex-grow-1 mb-3"><%= task.description || 'No description provided.' %></p>

                <div class="pt-2 border-top d-flex justify-content-between align-items-center mt-auto">
                  <div class="d-flex align-items-center gap-2">
                    <!-- Dynamic AJAX Status Toggle (Task 4 & 5) -->
                    <select class="form-select form-select-sm task-status-toggle" data-id="<%= task._id %>" style="width: auto; font-size: 0.75rem;">
                      <option value="Pending" <%= task.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                      <option value="In Progress" <%= task.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                      <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                    </select>
                  </div>

                  <div class="text-muted fs-8">
                    <% if (task.deadline) { %>
                      <i class="bi bi-calendar3 me-1"></i><%= new Date(task.deadline).toLocaleDateString() %>
                    <% } else { %>
                      <i class="bi bi-calendar-x me-1"></i>No due date
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- 2. Table View (Hidden by default, toggled via Task 4 JS) -->
      <div id="tasksTableContainer" class="card border-0 shadow-xs rounded-4 bg-white p-3 d-none">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="tasksMainTable">
            <thead class="table-light fs-8 text-uppercase text-secondary">
              <tr>
                <th>Title & Description</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Due Date</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (tasks && tasks.length > 0) { %>
                <% tasks.forEach(function(task) { %>
                  <tr class="task-table-row" data-id="<%= task._id %>" data-title="<%= task.title.toLowerCase() %>" data-status="<%= task.status %>" data-priority="<%= task.priority %>" data-category="<%= task.category %>">
                    <td>
                      <div class="fw-bold text-dark"><%= task.title %></div>
                      <div class="text-secondary fs-8 text-truncate" style="max-width: 320px;"><%= task.description %></div>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= task.category %></span></td>
                    <td>
                      <% if (task.priority === 'Urgent') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Urgent</span>
                      <% } else if (task.priority === 'High') { %>
                        <span class="badge bg-danger text-white">High</span>
                      <% } else if (task.priority === 'Medium') { %>
                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle">Medium</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary">Low</span>
                      <% } %>
                    </td>
                    <td>
                      <select class="form-select form-select-sm task-status-toggle" data-id="<%= task._id %>" style="width: auto; font-size: 0.75rem;">
                        <option value="Pending" <%= task.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="In Progress" <%= task.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                        <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                      </select>
                    </td>
                    <td class="text-muted fs-8">
                      <%= task.deadline ? new Date(task.deadline).toLocaleDateString() : 'None' %>
                    </td>
                    <td class="text-end">
                      <a href="/tasks/<%= task._id %>/edit" class="btn btn-xs btn-outline-secondary py-1 px-2" title="Edit">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <button class="btn btn-xs btn-outline-danger py-1 px-2 ms-1 delete-task-btn" data-id="<%= task._id %>" data-title="<%= task.title %>" title="Delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Empty State -->
      <div id="tasksEmptyState" class="card border-0 shadow-xs rounded-4 bg-white text-center py-5 <%= tasks && tasks.length > 0 ? 'd-none' : '' %>">
        <div class="py-4">
          <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
          <h5 class="fw-bold text-dark">No tasks match your criteria</h5>
          <p class="text-muted small">Try clearing your filters or create a new task to get started.</p>
          <a href="/tasks/new" class="btn btn-primary btn-sm px-4">Create New Task</a>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Delete Confirmation Modal (Task 4 & Task 5) -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deleteModalTitle">
          <i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-3">
        <p class="text-secondary mb-1">Are you sure you want to delete this task? This action cannot be undone.</p>
        <div class="p-3 bg-light rounded-3 border fw-semibold text-dark mt-2" id="deleteTaskTitlePreview">
          Task Title
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger d-flex align-items-center gap-2 px-3" id="confirmDeleteBtn">
          <i class="bi bi-trash3"></i> Delete via REST API
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Task client-side interactions (Task 4 & Task 5) -->
<script src="/js/tasks-client.js"></script>

<%- include('../partials/footer') %>

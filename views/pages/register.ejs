<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container my-5 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="text-center mb-4">
          <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2">
            <i class="bi bi-person-plus-fill fs-3"></i>
          </div>
          <h2 class="fw-bold tracking-tight mb-1">Create Account</h2>
          <p class="text-secondary small">Register to manage your tasks with TaskFlow</p>
        </div>

        <%- include('../partials/alerts') %>

        <!-- Registration Form (Task 1 & Task 2) -->
        <form action="/register" method="POST" id="registerForm" novalidate>
          <!-- Full Name -->
          <div class="mb-3">
            <label for="name" class="form-label small fw-semibold text-dark">Full Name <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-person"></i></span>
              <input
                type="text"
                class="form-control border-start-0"
                id="name"
                name="name"
                placeholder="Alex Morgan"
                value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>"
                required
                minlength="2"
                maxlength="50"
              />
            </div>
            <div class="invalid-feedback" id="nameFeedback">Please enter your full name (at least 2 characters).</div>
          </div>

          <!-- Email Address -->
          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold text-dark">Email Address <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-envelope"></i></span>
              <input
                type="email"
                class="form-control border-start-0"
                id="email"
                name="email"
                placeholder="alex@taskflow.dev"
                value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
                required
              />
            </div>
            <div class="invalid-feedback" id="emailFeedback">Please provide a valid email address format (e.g. name@domain.com).</div>
          </div>

          <!-- Phone Number (Task 2 validation) -->
          <div class="mb-3">
            <label for="phone" class="form-label small fw-semibold text-dark">Phone Number (Optional)</label>
            <div class="input-group">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-telephone"></i></span>
              <input
                type="tel"
                class="form-control border-start-0"
                id="phone"
                name="phone"
                placeholder="+1 555-0199"
                value="<%= typeof values !== 'undefined' && values.phone ? values.phone : '' %>"
              />
            </div>
            <div class="form-text text-muted small">Standard format: +1 555-0199 or 555-0199</div>
            <div class="invalid-feedback" id="phoneFeedback">Please provide a valid phone format.</div>
          </div>

          <!-- Password -->
          <div class="mb-3">
            <label for="password" class="form-label small fw-semibold text-dark">Password <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-lock"></i></span>
              <input
                type="password"
                class="form-control border-start-0 border-end-0"
                id="password"
                name="password"
                placeholder="••••••••"
                required
                minlength="6"
              />
              <button class="btn btn-light border border-start-0 text-secondary" type="button" id="togglePasswordBtn">
                <i class="bi bi-eye" id="togglePasswordIcon"></i>
              </button>
            </div>
            <!-- Password Strength Bar (Task 4) -->
            <div class="mt-2">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted" id="strengthText">Password Strength: <em>Enter password</em></span>
                <span class="badge bg-secondary-subtle text-secondary" id="strengthBadge">None</span>
              </div>
              <div class="progress" style="height: 6px;">
                <div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
            <!-- Criteria Checklist -->
            <ul class="list-unstyled small text-muted mt-2 mb-0" id="passwordCriteria">
              <li id="crit-len"><i class="bi bi-x-circle text-danger me-1"></i> At least 6 characters</li>
              <li id="crit-upper"><i class="bi bi-x-circle text-danger me-1"></i> Contains uppercase letter (A-Z)</li>
              <li id="crit-lower"><i class="bi bi-x-circle text-danger me-1"></i> Contains lowercase letter (a-z)</li>
              <li id="crit-num"><i class="bi bi-x-circle text-danger me-1"></i> Contains at least one digit (0-9)</li>
            </ul>
          </div>

          <!-- Confirm Password -->
          <div class="mb-4">
            <label for="confirmPassword" class="form-label small fw-semibold text-dark">Confirm Password <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-secondary border-end-0"><i class="bi bi-shield-check"></i></span>
              <input
                type="password"
                class="form-control border-start-0"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="••••••••"
                required
              />
            </div>
            <div class="invalid-feedback" id="confirmFeedback">Passwords do not match.</div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2" id="submitBtn">
            <i class="bi bi-check2-circle"></i> Complete Registration
          </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
          <span class="text-muted small">Already have an account?</span>
          <a href="/login" class="text-primary small fw-semibold text-decoration-none ms-1">Sign In here</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
